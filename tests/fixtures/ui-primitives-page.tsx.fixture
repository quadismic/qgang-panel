"use client";
import {useState} from "react";
import {CodexComposer} from "@/components/CodexComposer";
import {MemberPurgeControl} from "@/components/MemberPurgeControl";
import {SurfaceLayer} from "@/components/SurfaceLayer";
import {Dialog} from "@/components/ui/Dialog";
import {Button,Input,Select,Badge,Metadata,EmptyState,ErrorState} from "@/components/ui/Primitives";
import {OverflowMenu} from "@/components/ui/OverflowMenu";
import {ProgressiveList} from "@/components/ProgressiveList";
import {BudgetLedger} from "@/components/BudgetLedger";
import {AnnouncementsLedger} from "@/components/AnnouncementsLedger";
import {NavClient} from "@/components/NavClient";
import {CommentItem} from "@/components/CommentItem";
import {ImageCropper} from "@/components/ImageCropper";
export default function QA(){const [open,setOpen]=useState(false),[nested,setNested]=useState(false),[file,setFile]=useState<File|null>(null);const entries=Array.from({length:12},(_,i)=>({id:String(i),kind:i%2?"expense":"support",amount:100+i,title:"Uzun kayıt başlığı ve Türkçe karakterler "+i,description:"Ayrıntılı kayıt açıklaması ".repeat(20),category:"DESTEK",supporter_name:null,is_anonymous:true,created_at:"2026-10-06T18:00:00Z"}));return <main style={{padding:16,maxWidth:1200,margin:"auto"}}><h1>UI regresyonu</h1><Button id="trigger" onClick={()=>setOpen(true)}>Paneli aç</Button><Button id="background" onClick={()=>{throw Error('Background clicked')}}>Arka plan işlemi</Button><Input id="background-input" aria-label="Arka plan alanı"/><SurfaceLayer open={open} onClose={()=>setOpen(false)} title="Kimlik paneli"><Input aria-label="Panel alanı"/><Button onClick={()=>setNested(true)}>İkinci dialog</Button><Button id="last">Son işlem</Button><Dialog open={nested} onClose={()=>setNested(false)} title="İkinci dialog"><Button onClick={()=>setNested(false)}>İkinciyi kapat</Button></Dialog></SurfaceLayer><label>Görsel seç<input id="crop-file" type="file" onChange={e=>setFile(e.target.files?.[0]||null)}/></label>{file&&<ImageCropper file={file} kind="avatar" onCancel={()=>setFile(null)} onDone={()=>setFile(null)}/>}<Select aria-label="Tür"><option>Örnek</option></Select><Badge>DUYURU</Badge><Metadata>6 Ekim · Sürüm 1</Metadata><OverflowMenu label="Örnek işlemler"><Button level="tertiary">Görüntüle</Button><Button level="destructive">Sil</Button></OverflowMenu><section id="progressive"><ProgressiveList initial={2} step={3}>{entries.slice(0,6).map(e=><p key={e.id}>Satır {e.id}</p>)}</ProgressiveList></section><BudgetLedger entries={entries} canDelete/><AnnouncementsLedger items={entries.map(e=>({id:e.id,title:e.title,body:e.description,category:"DUYURU",priority:"normal",is_pinned:false,published_at:e.created_at}))} canDelete/><CommentItem id="c" body="Örnek yorum" author={{display_name:"Örnek"}} createdAt="2026-10-06T18:00:00Z" canDelete action="/qa" returnTo="/qa"/><EmptyState title="Kayıt yok" message="Örnek boş durum"/><ErrorState message="Örnek hata"/><CodexComposer action={()=>{}} sections={[{number:"01",title:"Temel"}]} rules={[]}/><MemberPurgeControl id="qa" handle="ornek" name="Örnek"/><div id="nav-fixture"><NavClient manage={false} canViewBudget={false} identity={null}/></div></main>}
