import P0 from "@/app/account/page";
import P1 from "@/app/announcements/page";
import P2 from "@/app/budget/page";
import P3 from "@/app/campfires/[slug]/page";
import P4 from "@/app/control/access/page";
import P7 from "@/app/control/design/page";
import P9 from "@/app/control/page";
import P11 from "@/app/control/system/page";
import P12 from "@/app/entities/aster/page";
import P13 from "@/app/gizlilik/cerezler/page";
import P14 from "@/app/gizlilik/page";
import P15 from "@/app/gizlilik/saklama/page";
import P16 from "@/app/gizlilik/verilerim/page";
import P17 from "@/app/gizlilik/yonetim/metinler/page";
import P18 from "@/app/gizlilik/yonetim/page";
import P19 from "@/app/gizlilik/yonetim/saklama/page";
import P20 from "@/app/login/page";
import P21 from "@/app/maintenance/page";
import P22 from "@/app/members/page";
import P23 from "@/app/onboarding/page";
import P24 from "@/app/page";
import P25 from "@/app/penalties/page";
import P26 from "@/app/profile/edit/page";
import P27 from "@/app/profile/page";
import P28 from "@/app/publications/[slug]/page";
import P29 from "@/app/publications/page";
import P30 from "@/app/rozetler/page";
import P31 from "@/app/rules/page";
import P33 from "@/app/u/[handle]/page";
const pages:Record<string,any>={"/account":P0,"/announcements":P1,"/budget":P2,"/campfires/[slug]":P3,"/control/access":P4,"/control/design":P7,"/control":P9,"/control/system":P11,"/entities/aster":P12,"/gizlilik/cerezler":P13,"/gizlilik":P14,"/gizlilik/saklama":P15,"/gizlilik/verilerim":P16,"/gizlilik/yonetim/metinler":P17,"/gizlilik/yonetim":P18,"/gizlilik/yonetim/saklama":P19,"/login":P20,"/maintenance":P21,"/members":P22,"/onboarding":P23,"/":P24,"/penalties":P25,"/profile/edit":P26,"/profile":P27,"/publications/[slug]":P28,"/publications":P29,"/rozetler":P30,"/rules":P31,"/u/[handle]":P33};
const aliases:Record<string,string>={"/kodeks":"/rules","/duyurular":"/announcements","/yayinlar":"/publications","/topluluk":"/members","/disiplin":"/penalties","/butce":"/budget","/yonetim":"/control","/yonetim/erisim":"/control/access","/yonetim/sistem":"/control/system","/yonetim/tasarim":"/control/design","/profil":"/profile","/profil/edit":"/profile/edit","/settings":"/profile"};
export default async function QA({searchParams}:{searchParams:Promise<Record<string,string>>}){const {screen="/",...q}=await searchParams;let route=aliases[screen]||screen;const params:Record<string,string>={};if(screen==="/yonetim/uyelik"){route="/members";q.manage="1"}else if(screen.startsWith("/yonetim/uyelik/")){route="/members";q.manage="1";q.edit=screen.split("/").pop()!}else if(screen==="/yonetim/yayinlar"){route="/publications";q.studio="1"}else if(screen==="/yonetim/moderasyon")route="/penalties";else if(screen.startsWith("/yayinlar/")){route="/publications/[slug]";params.slug=screen.split("/").pop()!}else if(screen.startsWith("/u/")){route="/u/[handle]";params.handle=screen.split("/").pop()!}else if(screen.startsWith("/campfires/")){route="/campfires/[slug]";params.slug=screen.split("/").pop()!}const Page=pages[route];return Page?<Page params={Promise.resolve(params)} searchParams={Promise.resolve(q)}/>:<p>Fixture route missing: {route}</p>}
