import {NavClient} from '@/components/NavClient';
import {MobileNavClient} from '@/components/MobileNavClient';
import {EventDetailHeader} from '@/components/EventDetailHeader';
import {EventDetailActions} from '@/components/EventDetailActions';
import {EventAttendanceArchive} from '@/components/EventAttendanceArchive';
import {Button,Input} from '@/components/ui/Primitives';
export default async function QA({searchParams}:{searchParams:Promise<{admin?:string;empty?:string}>}){const q=await searchParams,admin=q.admin==='1';const form=<form className="eventForm"><label>Başlık<Input defaultValue="Korunan başlık"/></label><Button type="button">Kaydet</Button></form>;return <div className="appShell"><NavClient manage={admin} canViewEvents identity={{display_name:"QA Üyesi",handle:"qa",role:"member"}}/><main className="content"><div className="eventsPage"><EventDetailHeader event={{title:'Toplulukla birlikte uzun isimli bir mekânda gerçekleştirilen çok uzun başlıklı özel mangal ve buluşma etkinliği',status:'completed',starts_at:'2026-09-26T14:00:00Z',ends_at:'2026-09-26T14:00:00Z',date_only:true}} typeName="BBQ-GANG" returnHref="/etkinlikler?view=archive&type=bbq-gang&from=2026-01-01"/><EventDetailActions editForm={admin?form:undefined} statusForm={admin?form:undefined} attendanceForm={admin?form:undefined} linksForm={admin?form:undefined}/><section className="managementPanel eventDetail"><p>Buluşma: İstanbul</p><p className="eventResponseCounts">12 “Katılacağım” yanıtı</p></section><EventAttendanceArchive records={q.empty?[]:[{id:'1',attended:true,historical_name:null,member:{handle:'qa',display_name:'Uzun Rumuzlu Topluluk Üyesi'}},{id:'2',attended:true,historical_name:'Tarihsel Üye',member:null},{id:'3',attended:false,historical_name:'Katılmadı',member:null}]}/></div></main><MobileNavClient user manage={admin} canViewEvents/></div>}
