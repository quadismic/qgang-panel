import {MobileNavClient} from '@/components/MobileNavClient';
import {EventArchiveImport} from '@/components/EventArchiveImport';
import {NavClient} from '@/components/NavClient';
import Link from 'next/link';
import {UpcomingEvents} from '@/components/HomeEvents';
import {EventForm} from '@/components/EventForm';
import {EventList} from '@/components/EventList';
import {EventPageActions} from '@/components/EventPageActions';
import {Select,Input,Button} from '@/components/ui/Primitives';
import {brandTheme} from '@/config/brand-theme';
const types=[{id:'gang-up',name:'GANG-UP'},{id:'op-night',name:'OP-NIGHT'},{id:'bbq-gang',name:'BBQ-GANG'},{id:'q-nity',name:'Q-NITY'}];
const records=types.map((t,i)=>({id:String(i),title:i===0?'Toplulukla bir araya geldiğimiz oldukça uzun başlıklı ve tüm genişliklerde okunabilen etkinlik':'Örnek etkinlik '+(i+1),type_id:t.id,legacy_type:null,starts_at:'2026-10-10T17:00:00Z',ends_at:'2026-10-10T20:00:00Z',date_only:false,location:i===0?'İstanbul · Uzun mekân adı ve buluşma noktası':'Oyun / mekân',status:'published'}));
export default async function QA({searchParams}:{searchParams:Promise<{empty?:string;admin?:string;archive?:string}>}){const q=await searchParams,events=q.empty?[]:records,admin=q.admin==='1';return <div className="appShell"><NavClient manage={admin} canViewBudget canViewEvents identity={{display_name:"QA Üyesi",handle:"qa",role:"member"}}/><main className="content"><div className="eventsPage"><section className="roomScene eventHero unifiedPageHero" style={{backgroundImage:`linear-gradient(90deg,rgba(4,3,2,.82),rgba(4,3,2,.38)),url(${brandTheme.rooms.registry})`}}><span className="kicker">Q-GANG · BİR ARADA</span><h1>Etkinlikler</h1><p>Buluşmalar, oyun geceleri ve ortak anılar.</p></section><div className="eventPageToolbar"><nav className="eventTabs"><Link className="qgButton qgButton-tertiary" aria-current="page" href="#">Yaklaşan Etkinlikler</Link><Link className="qgButton qgButton-tertiary" href="#">Etkinlik Arşivi</Link></nav><EventPageActions proposalForm={<EventForm types={types} proposal/>} createForm={admin?<EventForm types={types}/>:undefined} archiveForm={admin?<EventArchiveImport embedded/>:undefined} settingsForm={admin?<p>Türler ve sıralama formu</p>:undefined}/></div><form className="eventFilters"><label>Tür<Select><option>Tüm türler</option>{types.map(t=><option key={t.id}>{t.name}</option>)}</Select></label>{q.archive&&<><label>Başlangıç<Input type="date"/></label><label>Bitiş<Input type="date"/></label></>}<Button>Filtrele</Button></form><EventList returnTo="/etkinlikler?view=archive&type=bbq-gang" events={events} types={types} viewerId="me" responses={[{event_id:'0',response:'going'}]} archive={!!q.archive} filtered={!!q.empty}/><UpcomingEvents data={{types,upcoming:events.slice(0,2)}}/><div className="homeEditorialGrid"><section className="homeFeedSection homePublications"><h2>Son Yayınlar</h2></section><section className="homeFeedSection homeNotices"><h2>Duyurular</h2></section></div></div></main><MobileNavClient user manage={admin} canViewEvents canViewBudget canViewDiscipline/></div>}
